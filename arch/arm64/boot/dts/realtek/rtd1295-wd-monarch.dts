/*
 * Western Digital My Cloud Home (single bay) / "Monarch" board
 *
 * Realtek RTD1295 SoC, 1 GiB DDR.
 *
 * Bring-up device tree for the mainline RTD1295 support, derived from the
 * Realtek 4.9 vendor board file (rtd-1295-monarch-1GB.dts). Only the pieces
 * required for a serial console and an externally loaded initramfs are
 * described here; further peripherals are added incrementally.
 *
 * The vendor U-Boot loads:
 *   - the kernel Image at physical 0x00280000 (Image text_offset),
 *   - the ramdisk (rescue.root.sata.cpio.gz_pad.img) at 0x02200000,
 *   - the dtb at a fixed address.
 */

/dts-v1/;

#include "rtd1295.dtsi"

/ {
	compatible = "wd,monarch", "realtek,rtd1295";
	model = "WD My Cloud Home (RTD1295 Monarch)";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		/*
		 * earlycon uses the dw-apb UART0 at 0x98007800 (8250 compatible,
		 * 32-bit mmio). ignore_loglevel + loglevel=8 raise the debug
		 * level for bring-up; printk.time=1 keeps boot timestamps in
		 * dmesg.
		 */
		bootargs = "earlycon=uart8250,mmio32,0x98007800 console=ttyS0,115200n8 loglevel=8 ignore_loglevel printk.time=1 init=/init";

		/* Ramdisk loaded by U-Boot to 0x02200000, 4 MiB window. */
		linux,initrd-start = <0x02200000>;
		linux,initrd-end   = <0x02600000>;
	};

	/* 1 GiB, boot ROM (below 0x1f000) excluded from usable RAM. */
	memory@1f000 {
		device_type = "memory";
		reg = <0x1f000 0x3ffe1000>;
	};
};

/*
 * Realtek RTD129x interrupt mux. Demultiplexes the MISC (GIC SPI 40) and ISO
 * (GIC SPI 41) interrupt groups. The register windows live inside the misc
 * (0x9801b000) and iso (0x98007000) syscon blocks.
 *
 * Kept disabled for now: the driver and plumbing are validated (it correctly
 * delivers e.g. the UART0 line as hwirq 34), but routing the ttyS0 console
 * through it triggers an interrupt storm because the dw-apb UART interrupt is
 * not deasserted by the handler in this path. The console works fine in polled
 * mode, so the mux is enabled together with the first peripheral that needs it
 * (and can be validated against a single, observable interrupt).
 */
&rbus {
	mux_intc: interrupt-controller@1b000 {
		compatible = "Realtek,rtk-irq-mux";
		reg = <0x1b000 0x100>,	/* MISC */
		      <0x7000 0x100>;	/* ISO */
		Realtek,mux-nr = <2>;
		interrupt-controller;
		#interrupt-cells = <2>;
		interrupt-parent = <&gic>;
		interrupts = <GIC_SPI 40 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 41 IRQ_TYPE_LEVEL_HIGH>;
		intr-status = <0xc>, <0x0>;
		intr-en = <0x80>, <0x40>;
		status = "disabled";
	};
};

&uart0 {
	/* Polled mode for now; see mux_intc note above. */
	status = "okay";
};

/*
 * Secondary CPU bring-up. The RTD1295 vendor firmware/U-Boot parks cores 1-3
 * spinning on a 32-bit release register in the SB2 block (0x9801aa44); release
 * them with the Realtek spin-table variant. Without this only CPU0 comes up.
 */
&cpu0 {
	enable-method = "rtk-spin-table";
	cpu-release-addr = <0x0 0x9801aa44>;
};

&cpu1 {
	enable-method = "rtk-spin-table";
	cpu-release-addr = <0x0 0x9801aa44>;
};

&cpu2 {
	enable-method = "rtk-spin-table";
	cpu-release-addr = <0x0 0x9801aa44>;
};

&cpu3 {
	enable-method = "rtk-spin-table";
	cpu-release-addr = <0x0 0x9801aa44>;
};

/*
 * Realtek RTD1295 clock controllers. The CRT (cc) and ISO (ic) controllers
 * live inside the crt (0x98000000) and iso (0x98007000) syscon blocks and
 * provide the gate/PLL clocks for the SoC peripherals. They each also expose
 * an embedded reset controller, but peripherals use the existing reset-simple
 * controllers from rtd129x.dtsi, so these reset providers stay unreferenced.
 *
 * realtek,sb2-lock is intentionally omitted: the SB2 hardware semaphore is
 * only needed to coordinate register access with the (currently idle) audio/
 * video co-processors.
 */
&crt {
	cc: clock-controller {
		compatible = "realtek,rtd1295-crt-clk";
		#clock-cells = <1>;
		#reset-cells = <1>;
	};
};

&iso {
	ic: clock-controller {
		compatible = "realtek,rtd1295-iso-clk";
		#clock-cells = <1>;
		#reset-cells = <1>;
	};
};
