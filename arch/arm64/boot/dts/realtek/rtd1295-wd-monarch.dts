// SPDX-License-Identifier: (GPL-2.0-or-later OR BSD-2-Clause)
/*
 * Western Digital My Cloud Home (single bay) / "Monarch" board
 *
 * Realtek RTD1295 SoC, 1 GiB DDR.
 *
 * Bring-up device tree for the mainline RTD1295 support, derived from the
 * Realtek 4.9 vendor board file (rtd-1295-monarch-1GB.dts). Only the pieces
 * required for a serial console and an externally loaded initramfs are
 * described here; further peripherals are added incrementally.
 *
 * The vendor U-Boot loads:
 *   - the kernel Image at physical 0x00280000 (Image text_offset),
 *   - the ramdisk (rescue.root.sata.cpio.gz_pad.img) at 0x02200000,
 *   - the dtb at a fixed address.
 */

/dts-v1/;

#include <dt-bindings/clock/rtd1295-clk.h>
#include <dt-bindings/reset/realtek,rtd1295.h>
#include <dt-bindings/regulator/gmt,g22xx.h>
#include <dt-bindings/thermal/thermal.h>
#include "rtd1295.dtsi"

/ {
	compatible = "wd,monarch", "realtek,rtd1295";
	model = "WD My Cloud Home (RTD1295 Monarch)";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		/*
		 * earlycon uses the dw-apb UART0 at 0x98007800 (8250 compatible,
		 * 32-bit mmio). ignore_loglevel + loglevel=8 raise the debug
		 * level for bring-up; printk.time=1 keeps boot timestamps in
		 * dmesg.
		 */
		bootargs = "earlycon=uart8250,mmio32,0x98007800 console=ttyS0,115200n8 loglevel=8 ignore_loglevel printk.time=1 init=/init";

		/* Ramdisk loaded by U-Boot to 0x02200000, 4 MiB window. */
		linux,initrd-start = <0x02200000>;
		linux,initrd-end   = <0x02600000>;
	};

	/* 1 GiB, boot ROM (below 0x1f000) excluded from usable RAM. */
	memory@1f000 {
		device_type = "memory";
		reg = <0x1f000 0x3ffe1000>;
	};

	/*
	 * 27 MHz crystal. The ISO I2C controllers are clocked directly from
	 * this oscillator (the CCU only provides an enable gate with no rate),
	 * so the DesignWare driver reads the SCL timing source from here.
	 */
	osc27m: osc27m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <27000000>;
		clock-output-names = "osc27m";
	};

	/* Front-panel system LED, driven by PWM channel 3 (~10 kHz). */
	leds {
		compatible = "pwm-leds";

		led-sys {
			label = "sys";
			pwms = <&pwm 3 100000>;
			max-brightness = <255>;
			linux,default-trigger = "heartbeat";
		};
	};
};

/*
 * Realtek RTD129x interrupt mux. Demultiplexes the MISC (GIC SPI 40) and ISO
 * (GIC SPI 41) interrupt groups. The register windows live inside the misc
 * (0x9801b000) and iso (0x98007000) syscon blocks.
 *
 * The mux now masks all sub-interrupts at probe (the driver clears the
 * hardware enable registers), so bootloader-enabled sources no longer storm
 * the chained parent IRQ. It is needed as the interrupt parent for the GPIO
 * controllers. The ttyS0 console is deliberately *not* routed through it (it
 * stays in polled mode) to avoid the dw-apb UART interrupt-ack problem.
 */
&rbus {
	mux_intc: interrupt-controller@1b000 {
		compatible = "Realtek,rtk-irq-mux";
		reg = <0x1b000 0x100>,	/* MISC */
		      <0x7000 0x100>;	/* ISO */
		Realtek,mux-nr = <2>;
		interrupt-controller;
		#interrupt-cells = <2>;
		interrupt-parent = <&gic>;
		interrupts = <GIC_SPI 40 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 41 IRQ_TYPE_LEVEL_HIGH>;
		intr-status = <0xc>, <0x0>;
		intr-en = <0x80>, <0x40>;
		status = "okay";
	};
};

&uart0 {
	/*
	 * Interrupt-driven console, replicating the vendor 4.9 path: UART0 is
	 * ISO interrupt-mux group 1, bit 2. The earlier mux handler bugs (RVD
	 * always-service, whole-word force-ack) that made this storm are fixed,
	 * and the 8250_dw driver clears the dw-apb busy-detect interrupt, so the
	 * console can leave polled mode. (The vendor's extra "interrupts-st-mask"
	 * property is not needed: the mainline mux maps the status bit itself.)
	 */
	interrupt-parent = <&mux_intc>;
	interrupts = <1 2>;
	status = "okay";
};

/*
 * Secondary CPU bring-up. The RTD1295 vendor firmware/U-Boot parks cores 1-3
 * spinning on a 32-bit release register in the SB2 block (0x9801aa44); release
 * them with the Realtek spin-table variant. Without this only CPU0 comes up.
 *
 * All four cores share the SCPU PLL (cc RTD1295_CRT_PLL_SCPU, a settable
 * clk_pll_div) and the g2227 dc2 rail (cpu_supp), so they form a single
 * cpufreq policy (opp-shared) driven by cpufreq-dt against cpu_opps.
 */
&cpu0 {
	enable-method = "rtk-spin-table";
	cpu-release-addr = <0x0 0x9801aa44>;
	clocks = <&cc RTD1295_CRT_PLL_SCPU>;
	operating-points-v2 = <&cpu_opps>;
	cpu-supply = <&cpu_supp>;
	/* cpufreq cooling device for the thermal zone (opp-shared: cpu0 master) */
	#cooling-cells = <2>;
};

&cpu1 {
	enable-method = "rtk-spin-table";
	cpu-release-addr = <0x0 0x9801aa44>;
	clocks = <&cc RTD1295_CRT_PLL_SCPU>;
	operating-points-v2 = <&cpu_opps>;
	cpu-supply = <&cpu_supp>;
};

&cpu2 {
	enable-method = "rtk-spin-table";
	cpu-release-addr = <0x0 0x9801aa44>;
	clocks = <&cc RTD1295_CRT_PLL_SCPU>;
	operating-points-v2 = <&cpu_opps>;
	cpu-supply = <&cpu_supp>;
};

&cpu3 {
	enable-method = "rtk-spin-table";
	cpu-release-addr = <0x0 0x9801aa44>;
	clocks = <&cc RTD1295_CRT_PLL_SCPU>;
	operating-points-v2 = <&cpu_opps>;
	cpu-supply = <&cpu_supp>;
};

/*
 * CPU operating points for DVFS. Frequencies/voltages mirror the vendor
 * rtd-129x-dvfs-v1p0.dtsi (enabled points only); the SCPU PLL realises each
 * via PLL freq x post-divider (e.g. 900 MHz = 1800/2, 300 MHz = 1200/4) and
 * the voltages all fall on g2227 dc2's 12.5 mV grid.
 */
&{/} {
	cpu_opps: opp-table-cpu {
		compatible = "operating-points-v2";
		opp-shared;

		opp-300000000 {
			opp-hz = /bits/ 64 <300000000>;
			opp-microvolt = <800000>;
			clock-latency-ns = <150000>;
		};
		opp-500000000 {
			opp-hz = /bits/ 64 <500000000>;
			opp-microvolt = <800000>;
			clock-latency-ns = <150000>;
		};
		opp-600000000 {
			opp-hz = /bits/ 64 <600000000>;
			opp-microvolt = <825000>;
			clock-latency-ns = <150000>;
		};
		opp-700000000 {
			opp-hz = /bits/ 64 <700000000>;
			opp-microvolt = <850000>;
			clock-latency-ns = <150000>;
		};
		opp-800000000 {
			opp-hz = /bits/ 64 <800000000>;
			opp-microvolt = <875000>;
			clock-latency-ns = <150000>;
		};
		opp-900000000 {
			opp-hz = /bits/ 64 <900000000>;
			opp-microvolt = <900000>;
			clock-latency-ns = <150000>;
		};
		opp-1000000000 {
			opp-hz = /bits/ 64 <1000000000>;
			opp-microvolt = <925000>;
			clock-latency-ns = <150000>;
		};
		opp-1100000000 {
			opp-hz = /bits/ 64 <1100000000>;
			opp-microvolt = <962500>;
			clock-latency-ns = <150000>;
		};
		opp-1200000000 {
			opp-hz = /bits/ 64 <1200000000>;
			opp-microvolt = <1012500>;
			clock-latency-ns = <150000>;
			opp-suspend;
		};
		opp-1300000000 {
			opp-hz = /bits/ 64 <1300000000>;
			opp-microvolt = <1062500>;
			clock-latency-ns = <150000>;
		};
		opp-1400000000 {
			opp-hz = /bits/ 64 <1400000000>;
			opp-microvolt = <1100000>;
			clock-latency-ns = <150000>;
		};
	};
};

/*
 * On-SoC thermal sensor (in the SCPU wrapper at 0x9801d150) and the CPU
 * thermal zone. Two passive trips throttle the CPU through the OPP table via
 * the cpufreq cooling device; the critical trip triggers an orderly shutdown.
 * Trip temperatures mirror the vendor rtd-129x-dvfs-v1p0.dtsi.
 */
&scpu_wrapper {
	cpu_tm: thermal-sensor@150 {
		compatible = "realtek,rtd1295-thermal-sensor";
		reg = <0x150 0x20>;
		#thermal-sensor-cells = <0>;
	};
};

&{/} {
	thermal-zones {
		cpu-thermal {
			polling-delay-passive = <250>;
			polling-delay = <1000>;
			thermal-sensors = <&cpu_tm>;

			trips {
				cpu_alert0: cpu-alert0 {
					temperature = <105000>;
					hysteresis = <3000>;
					type = "passive";
				};
				cpu_alert1: cpu-alert1 {
					temperature = <115000>;
					hysteresis = <3000>;
					type = "passive";
				};
				cpu_crit: cpu-crit {
					temperature = <130000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_alert0>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
				map1 {
					trip = <&cpu_alert1>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};
	};
};

/*
 * Realtek RTD1295 clock controllers. The CRT (cc) and ISO (ic) controllers
 * live inside the crt (0x98000000) and iso (0x98007000) syscon blocks and
 * provide the gate/PLL clocks for the SoC peripherals. They each also expose
 * an embedded reset controller, but peripherals use the existing reset-simple
 * controllers from rtd129x.dtsi, so these reset providers stay unreferenced.
 *
 * realtek,sb2-lock is intentionally omitted: the SB2 hardware semaphore is
 * only needed to coordinate register access with the (currently idle) audio/
 * video co-processors.
 */
&crt {
	cc: clock-controller {
		compatible = "realtek,rtd1295-crt-clk";
		#clock-cells = <1>;
		#reset-cells = <1>;
	};

	/*
	 * Power-domain controller for the video engines, Mali GPU and NAT
	 * accelerator. None of those blocks has a driver on this NAS, so the
	 * genpd core powers the (unused) domains down at boot, isolating each
	 * island before cutting its SRAM power. This is the safe way to shed
	 * the GPU/VE leakage; cutting the external GPU rail (g2227 dc3)
	 * directly instead hangs the SoC interconnect.
	 */
	pd: power-controller {
		compatible = "realtek,rtd1295-power";
		#power-domain-cells = <1>;
	};
};

&iso {
	ic: clock-controller {
		compatible = "realtek,rtd1295-iso-clk";
		#clock-cells = <1>;
		#reset-cells = <1>;
	};
};

/*
 * Serial Flash Controller for the boot SPI-NOR (holds U-Boot / BL31). Exposed
 * as an spi-mem controller so the generic spi-nor core drives the chip; the
 * flash shows up as an MTD device (e.g. to read the U-Boot environment). The
 * controller drives the flash through a memory-mapped window, so writes to the
 * boot flash are possible - treat the MTD device with care.
 */
&rbus {
	sfc: spi@1a800 {
		compatible = "realtek,rtd1295-sfc";
		reg = <0x1a800 0x50>;
		#address-cells = <1>;
		#size-cells = <0>;

		flash@0 {
			compatible = "jedec,spi-nor";
			reg = <0>;
			spi-max-frequency = <50000000>;
		};
	};
};

/*
 * The remaining RTD1295 pad-mux banks. Each lives in its own register
 * window so it is a separate pinctrl-rtd instance:
 *   SB2  @0x9801a000 (sb2 syscon)  - MISC GPIOs, i2c2-5, SPI, RGMII, TP...
 *   CR   @0x98012000               - SD/eMMC/NAND/SDIO/PCIe pads
 *   DISP @0x9804d000               - audio in/out, SPDIF, DMIC pads
 * They are added for completeness; no consumer wires them yet, so the
 * driver just registers the mux capability (no register access at probe).
 */
&sb2 {
	pinctrl_sb2: pinctrl@0 {
		compatible = "realtek,rtd1295-sb2-pinctrl";
		reg = <0x0 0x97c>;
	};
};

&rbus {
	pinctrl_cr: pinctrl@12000 {
		compatible = "realtek,rtd1295-cr-pinctrl";
		reg = <0x12000 0x640>;
	};

	pinctrl_disp: pinctrl@4d000 {
		compatible = "realtek,rtd1295-disp-pinctrl";
		reg = <0x4d000 0x10>;
	};
};

/* RTC lives in the misc syscon block (0x9801b600). */
&misc {
	rtc: rtc@600 {
		compatible = "realtek,rtd1295-rtc";
		reg = <0x600 0x34>;
		clocks = <&cc RTD1295_CRT_CLK_EN_MISC_RTC>;
	};

	/*
	 * MISC GPIO bank (101 lines). reg[0] = GPIO data registers (0x9801b100),
	 * reg[1] = GPIO interrupt registers (0x9801b000, shared with the misc
	 * syscon/mux window - mapped non-exclusively by the driver). The
	 * assert/deassert interrupts are MISC mux group 0 bits 19 (GPIOA) and
	 * 20 (GPIODA). The ISO bank is added separately once this is validated.
	 */
	gpio_misc: gpio@100 {
		compatible = "realtek,rtd1295-misc-gpio";
		reg = <0x100 0x100>, <0x0 0x100>;
		interrupt-parent = <&mux_intc>;
		interrupts = <0 19>, <0 20>;
		gpio-controller;
		#gpio-cells = <2>;
		interrupt-controller;
		#interrupt-cells = <2>;
	};
};

/*
 * ISO GPIO bank (35 lines, gpio base 101). reg[0] = GPIO data registers
 * (0x98007100), reg[1] = GPIO interrupt registers (0x98007000). reg[1] is
 * the base of the ISO syscon and overlaps iso_reset@88 and the UART reset
 * line; the gpio-rtd driver maps it non-exclusively so they coexist.
 * Interrupts are ISO mux group 1 bits 19 (GPIOA) and 20 (GPIODA).
 */
&iso {
	/*
	 * ISO pad mux controller. The RTD1295 pin mux/config registers for
	 * the ISO bank live at 0x98007300..0x98007320; map the start of the
	 * ISO block (reg 0x0) so the driver's mux offsets (0x310/0x314/0x31c)
	 * are used verbatim. Non-exclusive of_iomap, so it coexists with the
	 * other ISO-window consumers.
	 */
	pinctrl: pinctrl@0 {
		compatible = "realtek,rtd1295-iso-pinctrl";
		reg = <0x0 0x400>;

		i2c0_pins: i2c0-pins {
			function = "i2c0";
			groups = "i2c_scl_0", "i2c_sda_0";
		};

		/*
		 * Ethernet activity/link LEDs. The MAC drives two LED outputs
		 * (etn_led_link, etn_led_rxtx) but the pads default to GPIO, so
		 * only one physical LED lit up. Mux both to the etn_led function
		 * (matching the vendor etn_led_pins group) so the MAC LEDSEL
		 * config reaches the front-panel LEDs.
		 */
		etn_led_pins: etn-led-pins {
			function = "etn_led";
			groups = "etn_led_link", "etn_led_rxtx";
		};
	};

	gpio_iso: gpio@100 {
		compatible = "realtek,rtd1295-iso-gpio";
		reg = <0x100 0x100>, <0x0 0x100>;
		interrupt-parent = <&mux_intc>;
		interrupts = <1 19>, <1 20>;
		gpio-controller;
		#gpio-cells = <2>;
		interrupt-controller;
		#interrupt-cells = <2>;
	};
};

/*
 * On-SoC gigabit Ethernet (RTL8169-derived MAC + embedded PHY).
 * reg[0] = MAC, reg[1] = ISO syscon (PHY/PLL control). IRQ is a direct GIC
 * SPI (not via the interrupt mux). Clocks/resets come from the ISO clock
 * controller. Monarch uses the on-chip PHY (output-mode 0).
 */
&rbus {
	gmac: ethernet@16000 {
		compatible = "realtek,rtd1295-gmac";
		reg = <0x16000 0x1000>,	/* MAC */
		      <0x7000 0x1000>;	/* ISO syscon */
		interrupt-parent = <&gic>;
		interrupts = <GIC_SPI 22 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&ic RTD1295_ISO_CLK_EN_ETN_SYS>,
			 <&ic RTD1295_ISO_CLK_EN_ETN_250M>;
		clock-names = "etn_sys", "etn_250m";
		/* ISO reset-simple controller (rtd129x.dtsi), bits GMAC=9 GPHY=10 */
		resets = <&iso_reset RTD1295_ISO_RSTN_GMAC>,
			 <&iso_reset RTD1295_ISO_RSTN_GPHY>;
		reset-names = "gmac", "gphy";
		pinctrl-names = "default";
		pinctrl-0 = <&etn_led_pins>;
		status = "okay";
	};

	/*
	 * PWM controller (4 channels), at 0x980070d0 within the ISO block.
	 * Channel 3 drives the front-panel system LED. The register window
	 * overlaps the non-exclusively-mapped ISO GPIO interrupt window, which
	 * is harmless.
	 */
	pwm: pwm@70d0 {
		compatible = "realtek,rtd1295-pwm";
		reg = <0x70d0 0xc>;
		#pwm-cells = <2>;
	};

	/*
	 * I2C bus 0 (ISO block, 0x98007d00). The RTD1295 I2C controller is a
	 * Synopsys DesignWare APB I2C, so the mainline i2c-designware driver
	 * drives it directly. The g2227 PMIC that controls the CPU/GPU/DDR
	 * rails hangs off this bus at 7-bit address 0x12; U-Boot already talks
	 * to it here, so the pads and the ISO i2c0 clock gate are left as the
	 * firmware set them. The functional clock is the 27 MHz crystal; the
	 * interrupt is ISO mux group 1, bit 8.
	 */
	i2c0: i2c@7d00 {
		compatible = "snps,designware-i2c";
		reg = <0x7d00 0x100>;
		interrupt-parent = <&mux_intc>;
		interrupts = <1 8>;
		clocks = <&osc27m>;
		clock-frequency = <100000>;
		resets = <&iso_reset RTD1295_ISO_RSTN_I2C_0>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2c0_pins>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		/*
		 * GMT G2227 PMIC. Supplies the SCPU (dc2), GPU (dc3), DDR
		 * (dc4) and other RTD1295 rails. All rails are marked
		 * always-on: firmware brings them up and several (vd33, ddr,
		 * iso, top) are critical, so the regulator core must not gate
		 * them as "unused". The cpu-supply/OPP wiring for DVFS is added
		 * in a later step; for now this just registers the regulators.
		 * Rail constraints mirror the vendor rtd-129x-dvfs-v1p0.dtsi.
		 */
		pmic: pmic@12 {
			compatible = "gmt,g2227";
			reg = <0x12>;

			regulators {
				compatible = "gmt,g2227-regulator";

				vd33_supp: dc1 {
					regulator-name = "vd33";
					regulator-min-microvolt = <3000000>;
					regulator-max-microvolt = <3300000>;
					regulator-boot-on;
					regulator-always-on;
					regulator-initial-mode = <G22XX_DC_MODE_FORCE_PWM>;
				};

				cpu_supp: dc2 {
					regulator-name = "cpudvs";
					regulator-min-microvolt = <800000>;
					regulator-max-microvolt = <1187500>;
					regulator-boot-on;
					regulator-always-on;
					regulator-initial-mode = <G22XX_DC_MODE_AUTO>;
				};

				gpu_supp: dc3 {
					regulator-name = "gpudvs";
					/*
					 * The GPU island is held powered-off via
					 * genpd, so nothing scales this rail.
					 * Pin it to the 0.8 V minimum (instead of
					 * the firmware default 1.0 V) to shave the
					 * isolated island's leakage. Keep it
					 * always-on: cutting dc3 outright halts the
					 * SoC.
					 */
					regulator-min-microvolt = <800000>;
					regulator-max-microvolt = <800000>;
					regulator-boot-on;
					regulator-always-on;
					regulator-initial-mode = <G22XX_DC_MODE_AUTO>;
					regulator-ramp-delay = <625>;
				};

				ddr_supp: dc4 {
					regulator-name = "ddr";
					regulator-min-microvolt = <1500000>;
					regulator-max-microvolt = <1500000>;
					regulator-boot-on;
					regulator-always-on;
					regulator-initial-mode = <G22XX_DC_MODE_AUTO>;
				};

				iso_supp: dc5 {
					regulator-name = "iso";
					regulator-min-microvolt = <800000>;
					regulator-max-microvolt = <1187500>;
					regulator-boot-on;
					regulator-always-on;
					regulator-initial-mode = <G22XX_DC_MODE_AUTO>;
				};

				top_supp: dc6 {
					regulator-name = "top";
					regulator-min-microvolt = <800000>;
					regulator-max-microvolt = <1187500>;
					regulator-boot-on;
					regulator-always-on;
					regulator-initial-mode = <G22XX_DC_MODE_AUTO>;
				};

				vd18_supp: ldo2 {
					regulator-name = "ldo2";
					regulator-min-microvolt = <1500000>;
					regulator-max-microvolt = <1900000>;
					regulator-boot-on;
					regulator-always-on;
					regulator-initial-mode = <G22XX_LDO_MODE_NORMAL>;
				};

				l2_supp: ldo3 {
					regulator-name = "ldo3";
					regulator-min-microvolt = <800000>;
					regulator-max-microvolt = <1200000>;
					regulator-boot-on;
					regulator-always-on;
					regulator-initial-mode = <G22XX_LDO_MODE_NORMAL>;
				};
			};
		};
	};

	/*
	 * USB: the RTD1295 DRD/OTG port, driven in host mode by the mainline
	 * dwc3-rtk wrapper + dwc3 core + Realtek USB2/USB3 phys. Register layout
	 * mapped from the vendor rtd-129x-usb.dtsi (DRD group):
	 *   wrapper   0x98013200, dwc3 core 0x98020000 (IRQ GIC SPI 21),
	 *   usb2phy   data 0x98028280 / control 0x98013214,
	 *   usb3phy   0x98013210.
	 * Clocks/resets are left to the firmware-on state (clk_ignore_unused);
	 * VBUS for this port is normally controlled by the Realtek USB power
	 * manager GPIO, not yet ported -- self-powered devices/hubs should still
	 * enumerate.
	 */
	usb2phy: usb-phy@28280 {
		compatible = "realtek,rtd1295-usb2phy";
		reg = <0x28280 0x4>,	/* PHY data */
		      <0x13214 0x4>;	/* PHY control */
		#phy-cells = <0>;
	};

	usb3phy: usb-phy@13210 {
		compatible = "realtek,rtd1295-usb3phy";
		reg = <0x13210 0x4>;
		#phy-cells = <0>;
	};

	usb_drd: usb@13200 {
		compatible = "realtek,rtd1295-dwc3", "realtek,rtd-dwc3";
		reg = <0x13200 0x200>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/*
		 * Cold-init resources so USB works when U-Boot boots from SATA
		 * without running "usb start": the USB clock gate, the port-0
		 * controller/PHY resets (all in soft-reset-1), and the ISO
		 * syscon holding the USB SRAM/power-gating registers.
		 */
		clocks = <&cc RTD1295_CRT_CLK_EN_USB>;
		resets = <&reset1 RTD1295_RSTN_USB>,
			 <&reset1 RTD1295_RSTN_USB_PHY0>,
			 <&reset1 RTD1295_RSTN_USB3_PHY0_POW>,
			 <&reset1 RTD1295_RSTN_USB3_P0_MDIO>;
		reset-names = "usb", "u2phy0", "u3phy0", "u3mdio0";
		realtek,iso = <&iso>;

		dwc3@20000 {
			compatible = "snps,dwc3";
			reg = <0x20000 0x9000>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 21 IRQ_TYPE_LEVEL_HIGH>;
			phys = <&usb2phy>, <&usb3phy>;
			phy-names = "usb2-phy", "usb3-phy";
			dr_mode = "host";
			snps,dis_u2_susphy_quirk;
			snps,parkmode-disable-ss-quirk;
			snps,parkmode-disable-hs-quirk;
		};
	};

	/*
	 * SATA: AHCI host + Realtek SATA PHY (single port). The board boots
	 * from this disk via U-Boot, so the drive is already powered when Linux
	 * starts; the vendor disk-power GPIO is not wired here.
	 *
	 * Resets come from the CRT (cc) embedded reset controller. The reset
	 * cell is the vendor bank<<8|bit index: SATA_0 = 0x05, SATA_PHY_0 =
	 * 0x07, SATA_PHY_POW_0 = 0x0a (all in CRT reset bank 0, reg 0x00).
	 */
	sata_phy: sata-phy@3ff00 {
		compatible = "Realtek,rtk-sata-phy";
		reg = <0x3ff00 0x100>,	/* SATA MDIO */
		      <0x1a980 0x10>;	/* SB2 */
		#address-cells = <1>;
		#size-cells = <0>;
		#phy-cells = <1>;
		status = "okay";

		sata-phy@0 {
			reg = <0>;
			resets = <&cc 0x0a>;	/* RSTN_SATA_PHY_POW_0 */
			reset-names = "rstn_sata_phy_pow_0";
			spread-spectrum = <0>;
			tx-driving = <2>;
			phy-param = <0x00001111>, <0x00005111>, <0x00009111>,
				    <0x336a0511>, <0x336a4511>, <0x336a8511>,
				    <0xe0700111>, <0xe05c4111>, <0xe04a8111>,
				    <0x00150611>, <0x00154611>, <0x00158611>,
				    <0xc6000a11>, <0xc6004a11>, <0xc6008a11>,
				    <0x70000211>, <0x70004211>, <0x70008211>,
				    <0xc6600a11>, <0xc6604a11>, <0xc6608a11>,
				    <0x20041911>, <0x20045911>, <0x20049911>,
				    <0x94aa2011>, <0x94aa6011>, <0x94aaa011>,
				    <0x17171511>, <0x17175511>, <0x17179511>,
				    <0x07701611>, <0x07705611>, <0x07709611>,
				    <0x00002a11>, <0x00006a11>, <0x0000aa11>,
				    <0x27710311>, <0x27684311>, <0x27648311>,
				    <0x29001011>, <0x29005011>, <0x29009011>,
				    <0xc0000c11>, <0xc0004c11>, <0xc0008c11>,
				    <0x00271711>, <0x00275711>, <0x00279711>;
			tx-driving-tbl = <0x94a72011>, <0x94a76011>, <0x94a7a011>,
					 <0x487a2111>, <0x487a6111>, <0x487aa111>;
			rx-sense-tbl = <0x72100911>, <0x72104911>, <0x72108911>,
				       <0x27750311>, <0x276e4311>, <0x276c8311>;
		};
	};

	sata: sata@3f000 {
		compatible = "realtek,rtd1295-ahci";
		reg = <0x3f000 0x1000>;
		interrupt-parent = <&gic>;
		interrupts = <GIC_SPI 28 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&cc RTD1295_CRT_CLK_EN_SATA_0>,
			 <&cc RTD1295_CRT_CLK_EN_SATA_ALIVE_0>;
		resets = <&cc 0x05>,	/* RSTN_SATA_0 */
			 <&cc 0x07>;	/* RSTN_SATA_PHY_0 */
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		sata-port@0 {
			reg = <0>;
			phys = <&sata_phy 0>;
		};
	};
};
