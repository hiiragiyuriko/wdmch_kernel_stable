# Lean bring-up config for the WD My Cloud Home (RTD1295 Monarch).
# Goal: serial console + externally loaded busybox initramfs, small Image
# (must fit below the ramdisk at 0x02200000).
CONFIG_LOCALVERSION="-wdmch"
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
CONFIG_EXPERT=y
CONFIG_PERF_EVENTS=y
CONFIG_ARCH_REALTEK=y
CONFIG_ARM64_TEXT_OFFSET=0x280000
CONFIG_RELOCATABLE=y
# CONFIG_RANDOMIZE_BASE is not set
CONFIG_NR_CPUS=4
CONFIG_SMP=y
CONFIG_PREEMPT_VOLUNTARY=y
# debugging / console verbosity
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=15
CONFIG_DYNAMIC_DEBUG=y
CONFIG_PRINTK_CALLER=y
CONFIG_DEBUG_INFO=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_FS=y
# core fs / userspace plumbing
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
# tty / serial
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_8250_EXTENDED=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y
# reset controller for the dw-apb UART reset line
CONFIG_RESET_CONTROLLER=y
CONFIG_RESET_SIMPLE=y
# Realtek RTD1295 clock controllers (CRT + ISO)
CONFIG_MFD_SYSCON=y
CONFIG_COMMON_CLK_REALTEK=y
CONFIG_COMMON_CLK_RTD1295=y
# The vendor U-Boot supplies its own cmdline (and overwrites /chosen/bootargs),
# but arm64 has no CMDLINE_EXTEND. Force our own command line during bring-up so
# that the clk core does not gate the PLLs/clocks left on by firmware
# (clk_ignore_unused, essential now that the clk controllers are registered but
# few consumers claim clocks) and the console stays fully verbose. The initramfs
# is still located via the DT /chosen linux,initrd-* properties.
CONFIG_CMDLINE="earlycon=uart8250,mmio32,0x98007800 console=ttyS0,115200n8 init=/init clk_ignore_unused ignore_loglevel printk.time=1"
CONFIG_CMDLINE_FORCE=y
# watchdog (rtd1295) - node already in rtd129x.dtsi
CONFIG_WATCHDOG=y
CONFIG_RTD119X_WATCHDOG=y
# RTC (rtd1295, in the misc syscon)
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_RTD119X=y
# pin controller (ISO bank) - muxes the i2c0 pads etc.
CONFIG_PINCTRL=y
CONFIG_PINCTRL_RTD=y
CONFIG_PINCTRL_RTD1295=y
# misc useful for bring-up
CONFIG_GPIOLIB=y
CONFIG_GPIO_RTD=y
# I2C bus 0 (DesignWare) - reaches the g2227 PMIC at 0x12
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
# g2227 PMIC (MFD + regulators) on i2c0 - SCPU/GPU/DDR rails
CONFIG_MFD_G2227=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_G2227=y
# CPU DVFS: SCPU PLL (settable) + cpu_opps + g2227 dc2, via cpufreq-dt
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPUFREQ_DT=y
CONFIG_CPUFREQ_DT_PLATDEV=y
# Thermal: RTD1295 sensor + cpufreq cooling (step_wise governor)
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_THERMAL_DEFAULT_GOV_STEP_WISE=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_CPU_THERMAL=y
CONFIG_CPU_FREQ_THERMAL=y
CONFIG_REALTEK_THERMAL=y
# RTD129x SoC chip-revision helper (used by the on-SoC GMAC)
CONFIG_REALTEK_SOC_CHIP=y
# networking + on-SoC GMAC (RTL8169-derived)
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169SOC=y
CONFIG_NET_CORE=y
CONFIG_PHYLIB=y
# USB host: RTD1295 DRD port via mainline dwc3-rtk + Realtek USB2/USB3 phys
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_HOST=y
CONFIG_USB_DWC3_RTK=y
CONFIG_GENERIC_PHY=y
CONFIG_PHY_RTK_RTD_USB2PHY=y
CONFIG_PHY_RTK_RTD_USB3PHY=y
CONFIG_NVMEM=y
CONFIG_USB_STORAGE=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
# SATA: RTD1295 AHCI host + Realtek SATA PHY
CONFIG_ATA=y
CONFIG_SATA_HOST=y
CONFIG_AHCI_RTK=y
CONFIG_PHY_RTK_RTD_SATA=y
# trim things we do not need yet to keep the Image small
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_SOUND is not set
# CONFIG_MMC is not set
# CONFIG_WLAN is not set
# CONFIG_INPUT is not set
# CONFIG_HID is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_VIRTUALIZATION is not set
# CONFIG_PCI is not set
CONFIG_PWM=y
CONFIG_PWM_RTK=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_PWM=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
